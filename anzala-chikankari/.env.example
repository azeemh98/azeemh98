# Copy to .env and fill in for production. All values have safe local defaults.
PORT=3000
NODE_ENV=production

# SQLite file path (default: ./data/anzala.db). Point this at a persistent volume in production.
DB_FILE=./data/anzala.db

# First-run admin account (only used the very first time the DB is empty — change the password after logging in).
ADMIN_EMAIL=admin@anzalachikankari.in
ADMIN_PASSWORD=ChangeMe@123

# Timezone used for "today" in the booking engine and order numbers.
STORE_TIMEZONE=Asia/Kolkata
